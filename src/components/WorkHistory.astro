---
import { Image } from 'astro:assets';
import elasticLogo from '~/assets/images/elastic-logo.png';
import { current, earlierCareer, previous } from '~/data/work';
---

<section class="section" aria-labelledby="work-heading">
  <h2 id="work-heading">Work</h2>

  <div class="role">
    <div class="role-identity">
      <Image
        src={elasticLogo}
        alt=""
        width={56}
        height={56}
        densities={[2]}
        class="role-logo"
      />
      <div class="identity-text">
        <h3>
          {current.url ? <a href={current.url}>{current.company}</a> : current.company}
        </h3>
        <p class="role-meta">{current.role} · {current.dates}</p>
      </div>
    </div>
    {current.paragraphs?.map((paragraph) => <p class="role-summary">{paragraph}</p>)}
  </div>

  <h3 class="subhead">Previously</h3>
  <ul class="previous">
    {
      previous.map((entry) => (
        <li>
          <span class="previous-company">
            {entry.url ? <a href={entry.url}>{entry.company}</a> : entry.company}
            {entry.role && <span class="previous-role">{entry.role}</span>}
          </span>
          <span class="previous-dates">{entry.dates}</span>
        </li>
      ))
    }
  </ul>
  <p class="role-summary">{earlierCareer}</p>
</section>
